this runs in the shell

class kadane-max-subarray

  define function findMaxSubarraySum with nums
    define max_so_far as nums item 1
    define current_max as nums item 1
    for i from 2 to length of nums
      define val as nums item i
      if (current_max + val) > val
        set current_max to current_max + val
      else
        set current_max to val
      if current_max > max_so_far
        set max_so_far to current_max
    return max_so_far

  define function main
    define start_cmd from user "Calculate Kadane sum?"
    define sequence as [-2, 1, -3, 4, -1, 2, 1, -5, 4]
    define best_sum as findMaxSubarraySum from sequence
    print best_sum
