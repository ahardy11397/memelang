this runs in the shell

class json-order-verifier

  define function loadDataFile with file_name
    if file_name is json
      define arr_obj as fromFile from file_name
      return arr_obj
    else return "Wrong File Type"

  define function isSortedAscending with nums_array
    define n as length of nums_array
    for i from 1 to (n - 1)
      if nums_array item i > nums_array item (i + 1)
        return 0
    return 1

  define function main
    define file_input from user "Target list JSON file?"
    define loaded_list as loadDataFile from file_input
    define sorted_status as isSortedAscending from loaded_list
    print sorted_status
