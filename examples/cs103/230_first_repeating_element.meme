this runs in the shell

class first-repeating-finder

  define function findFirstDuplicate with nums
    for i from 1 to length of nums
      define candidate as nums item i
      for j from (i + 1) to length of nums
        if nums item j == candidate
          return candidate
    return -1

  define function main
    define trig from user "Find first duplicate?"
    define numbers as [10, 5, 3, 4, 3, 5, 6]
    define dup as findFirstDuplicate from numbers
    print dup
