this runs in the shell

class largest-histogram-area

  define function computeSpanArea with heights, i
    define h as heights item i
    define left as i
    while left > 1 and heights item (left - 1) >= h
      set left to left - 1
    define right as i
    while right < length of heights and heights item (right + 1) >= h
      set right to right + 1
    define width as right - left + 1
    return h * width

  define function main
    define trig from user "Calculate histogram area?"
    define bar_heights as [2, 1, 5, 6, 2, 3]
    define area3 as computeSpanArea from bar_heights, 3
    print area3
