class unique-paths-with-obstacles

  define function pathWaysWithBlock with top_ways, left_ways, is_blocked
    if is_blocked == 1
      return 0
    return top_ways + left_ways

  define function main
    define trig from user "Compute cell ways?"
    define ways as pathWaysWithBlock from 1, 1, 0
    print ways
