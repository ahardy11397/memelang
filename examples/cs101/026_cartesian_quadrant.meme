this runs in the shell

define coord_x from user "Coordinate X?"
define coord_y from user "Coordinate Y?"
if coord_x > 0 and coord_y > 0
  print "Quadrant 1"
else if coord_x < 0 and coord_y > 0
  print "Quadrant 2"
else if coord_x < 0 and coord_y < 0
  print "Quadrant 3"
else if coord_x > 0 and coord_y < 0
  print "Quadrant 4"
else
  print "Axis"
