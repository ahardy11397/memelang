this runs in the shell

class find-largest
  
  define function loadFile with filepath
    if filepath is json
      define list as fromFile from filepath
      return fromFile 
    else return "Wrong File Type"

  define function findLargest with list
    define unsorted as list
    define sorted as empty

    check unsorted item 1 against unsorted item 2
      copy smaller item to sorted item 1
      foreach other item x in unsorted starting at item 2
        check item x against sorted item 1
          if item x is smaller
            move each item in sorted up 1 and copy item x to sorted item 1
          else 
            check next item x 
      stop when sorted item 1 is smaller than every other item in sorted && sorted item last is larger than every other item in sorted 
      return sorterd item last

  define function main  
    define filepath from user "Filepath?"

    define largest as findLargest from loadFile filepath

    print largest

      
