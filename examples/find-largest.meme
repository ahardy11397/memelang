this runs in the shell

class find-largest
  
  define function loadFile with filepath
    if filepath is json
      define list as fromFile from filepath
      return fromFile 
    else return "Wrong File Type"

  define function findLargest with list
    define unsorted as list
    define sorted as empty

    sort unsorted into sorted ascending

    return largest from sorted

  define function main  
    define filepath from user "Filepath?"

    define largest as findLargest from loadFile filepath

    print largest

      
