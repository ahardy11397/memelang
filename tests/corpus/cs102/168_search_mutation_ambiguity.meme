this runs in the shell

class search-mutation-hazard

  define function searchAndMutate with arr, target
    for i from 1 to length of arr
      if arr item i == target
        sort arr descending
        filter arr where item > 100
        return i
    return -1

  define function main
    define query from user "Query?"
    define numbers as [1, 3, 5, 7, 9]
    define pos as searchAndMutate from numbers, query
    print pos
