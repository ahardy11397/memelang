this runs in the shell

class json-positive-accumulator

  define function loadNumbers with path_str
    if path_str is json
      define raw_nums as fromFile from path_str
      return raw_nums
    else return "Wrong File Type"

  define function sumPositiveValues with items
    define pos_sum as 0
    for idx from 1 to length of items
      if items item idx > 0
        set pos_sum to pos_sum + items item idx
    return pos_sum

  define function main
    define doc_loc from user "File with negative numbers?"
    define list_vals as loadNumbers from doc_loc
    define total_pos as sumPositiveValues from list_vals
    print total_pos
