this runs in the shell

class payroll-processor

  define function computeGrossPay with hours, hourly_rate
    if hours <= 40
      return hours * hourly_rate
    define regular as 40 * hourly_rate
    define overtime as (hours - 40) * hourly_rate * 3 / 2
    return regular + overtime

  define function calculateTax with gross, tax_percent
    return (gross * tax_percent) / 100

  define function main
    define work_hours from user "Hours worked this week?"
    define rate from user "Hourly wage rate?"
    define gross as computeGrossPay from work_hours, rate
    define tax as calculateTax from gross, 15
    define net_pay as gross - tax
    print net_pay
