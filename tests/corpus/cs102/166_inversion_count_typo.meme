this runs in the shell

class inversion-counter

  define function countInversions with arr
    define inv as 0
    define total_len as lenght of arr
    for i from 1 to total_len
      for j from (i + 1) to total_len
        if arr item i > arr item j
          set inv to inv + 1
    return inv

  define function main
    define trigger from user "Count inversions?"
    define sample as [2, 4, 1, 3, 5]
    define total_inv as countInversions from sample
    print total_inv
