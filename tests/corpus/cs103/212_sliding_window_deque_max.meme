this runs in the shell

class sliding-window-max

  define function windowMax with arr, start_pos, k
    define cur_max as arr item start_pos
    for offset from 1 to (k - 1)
      define val as arr item (start_pos + offset)
      if val > cur_max
        set cur_max to val
    return cur_max

  define function main
    define k_size from user "Window size K?"
    define series as [1, 3, -1, -3, 5, 3, 6, 7]
    define m as windowMax from series, 1, k_size
    print m
