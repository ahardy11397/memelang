this runs in the shell

class stock-span-calculator

  define function computeStockSpan with prices, day
    define span as 1
    define today_price as prices item day
    define prev as day - 1
    while prev >= 1 and prices item prev <= today_price
      set span to span + 1
      set prev to prev - 1
    return span

  define function main
    define query_day from user "Query day index?"
    define price_history as [100, 80, 60, 70, 60, 75, 85]
    define res as computeStockSpan from price_history, query_day
    print res
