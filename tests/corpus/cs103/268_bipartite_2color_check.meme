this runs in the shell

class bipartite-coloring-check

  define function verifyColors with edge_u_colors, edge_v_colors
    for i from 1 to length of edge_u_colors
      if edge_u_colors item i == edge_v_colors item i
        return 0
    return 1

  define function main
    define trig from user "Verify bipartite colors?"
    define u_colors as [1, 2, 1]
    define v_colors as [2, 1, 2]
    define ok as verifyColors from u_colors, v_colors
    print ok
