this runs in the shell

class next-greater-element

  define function findNextGreater with nums, idx
    define val as nums item idx
    for j from (idx + 1) to length of nums
      if nums item j > val
        return nums item j
    return -1

  define function main
    define idx_query from user "Target index?"
    define list_vals as [4, 5, 2, 25]
    define next_val as findNextGreater from list_vals, idx_query
    print next_val
