this runs in the shell

class climbing-stairs-tribonacci

  define function waysToClimb with n
    if n <= 1
      return 1
    if n == 2
      return 2
    if n == 3
      return 4
    if n == 4
      return 7
    return 0

  define function main
    define step_count from user "Number of steps?"
    define ans as waysToClimb from step_count
    print ans
